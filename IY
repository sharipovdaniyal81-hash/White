local function newCmdEntry(text)
	local new = Example:Clone()
	new.Parent = cmdListFrame
	new.Text = text
	new.Visible = true
	new.Name = text:gsub("%s", "")
	new.ZIndex = 10
	new.MouseEnter:Connect(function()
		new.BackgroundTransparency = 0.7
		new.BackgroundColor3 = Color3.fromRGB(78, 78, 79)
	end)
	new.MouseLeave:Connect(function()
		new.BackgroundTransparency = 1
	end)
	new.MouseButton1Click:Connect(function()
		new.Text = ""
		if commands[1] then
			pcall(commands[1].Function)
		end
		task.wait(0.5)
		new.Text = text
	end)
	return new
end

for _, cmd in ipairs(commands) do
	newCmdEntry(cmd.Name)
end

-- ============ COMMAND EXECUTION ============
local function handleCommand(input)
	if not input or input == "" then return end
	for _, cmd in ipairs(commands) do
		if cmd.Name:lower() == input:lower() then
			local ok, err = pcall(cmd.Function)
			if not ok then
				warn("[Spider Project] command error:", err)
			end
			return
		end
	end
	warn("[Spider Project] unknown command:", input)
end

Cmdbar.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		handleCommand(Cmdbar.Text)
		Cmdbar.Text = ""
	end
end)

-- ============ DRAGGING ============
do
	local dragging, dragInput, dragStart, startPos
	local function update(input)
		local delta = input.Position - dragStart
		Holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
	Title.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = Holder.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	Title.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then update(input) end
	end)
end

-- ============ TOGGLE KEY (RightControl) ============
local visible = true
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.RightControl then
		visible = not visible
		Holder.Visible = visible
	end
end)

