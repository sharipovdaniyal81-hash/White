local function customAsset(asset)
	if getcustomasset then
		local ok, res = pcall(function() return getcustomasset(asset) end)
		if ok and res and res ~= "" then return res end
	end
	return assets[asset]
end

if makefolder and isfolder and writefile and isfile then
	pcall(function()
		local src = "https://raw.githubusercontent.com/infyiff/backup/refs/heads/main/"
		for _, folder in {"spiderproject", "spiderproject/assets"} do
			if not isfolder(folder) then makefolder(folder) end
		end
		for path in pairs(assets) do
			if not isfile(path) then
				writefile(path, game:HttpGet(src .. path:gsub("spiderproject/", "")))
			end
		end
		if IsOnMobile then writefile("spiderproject/assets/.nomedia", "") end
	end)
end

-- ============ RANDOM STRING ============
local function randomString()
	local len = math.random(10, 20)
	local t = {}
	for i = 1, len do
		t[i] = string.char(math.random(32, 126))
	end
	return table.concat(t)
end

