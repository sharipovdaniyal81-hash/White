local CDDF = {}
local function DamageFling(DmgPer)
    if Fling ~= true then return end
    if IsDead or DmgPer == playerss or CDDF[DmgPer] or not DmgPer then return end
    local h = DmgPer:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return end

    CDDF[DmgPer] = true
    StateMover = false

    local PosFling = (DmgPer:FindFirstChild("HumanoidRootPart") and DmgPer.HumanoidRootPart.CFrame.p)
                   or (DmgPer:FindFirstChildOfClass("Part") and DmgPer:FindFirstChildOfClass("Part").CFrame.p)
    if not PosFling then CDDF[DmgPer] = false; StateMover = true; return end

    bullet.Rotation = Torso.Rotation
    if bbav then bbav:Destroy() end
    bbav = Instance.new("BodyAngularVelocity", bullet)
    bbav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bbav.P = 100000000000000000000000000000
    bbav.AngularVelocity = Vector3.new(10000000000000000000000000000000, 100000000000000000000000000, 100000000000000000)

    for _=1,15 do
        bbv.Position = PosFling
        bullet.Position = PosFling
        task.wait(0.03)
    end
    bbav:Destroy()
    bbv.Position = Torso.CFrame.p
    bullet.Position = Torso.CFrame.p
    CDDF[DmgPer] = false
    StateMover = true
end

