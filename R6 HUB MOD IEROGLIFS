-- Ищет BillboardGui/SurfaceGui/Highlight и искажает текст
local function corruptOverhead(targetChar, level)
	level = level or 0.8
	for _, obj in ipairs(targetChar:GetDescendants()) do
		if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
			for _, desc in ipairs(obj:GetDescendants()) do
				if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
					if not desc:GetAttribute("_origText") then
						desc:SetAttribute("_origText", desc.Text)
					end
					local orig = desc:GetAttribute("_origText")
					if orig and orig ~= "" then
						pcall(function()
							desc.Text = corruptText(orig, level)
						end)
					end
				end
			end
		elseif obj:IsA("Highlight") then
			pcall(function()
				obj.FillColor = randomReplaceColor(obj.FillColor)
				obj.OutlineColor = randomReplaceColor(obj.OutlineColor)
			end)
		end
	end
end

-- Следим за новыми оверхед-объектами у ВСЕХ игроков
local function trackOverhead(targetChar)
	targetChar.DescendantAdded:Connect(function(obj)
		if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") or obj:IsA("Highlight") then
			task.wait(0.1)
			pcall(function()
				corruptOverhead(targetChar, postJumpscare and 1.0 or 0.6)
			end)

			-- И продолжаем коверкать периодически
			task.spawn(function()
				for i = 1, 15 do
					task.wait(0.4)
					if obj and obj.Parent then
						pcall(function()
							corruptOverhead(targetChar, postJumpscare and 1.0 or 0.6)
						end)
					else
						break
					end
				end
			end)
		end
	end)
end

-- Подключаем ко всем существующим игрокам
for _, p in ipairs(game.Players:GetPlayers()) do
	if p.Character then trackOverhead(p.Character) end
	p.CharacterAdded:Connect(trackOverhead)
end

game.Players.PlayerAdded:Connect(function(p)
