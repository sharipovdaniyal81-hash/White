-- ============================================================
-- ГЛИТЧИ ДО ПЕРВОГО СКРИМЕРА
-- ============================================================
task.spawn(function()
	task.wait(GLITCH_START_AT)
	while not jumpscareFired do
		local elapsed = tick() - SESSION_START
		local progress = math.clamp(elapsed / FIRST_JUMPSCARE_AT, 0, 1)

		local intensity = 0.6 + progress * 1.5
		local duration  = 0.4 + progress * 1.2

		cameraShake(intensity, duration)

		if math.random() < 0.7 then
			characterLag(duration * 0.6)
		end
		if math.random() < 0.5 then
			task.spawn(function() corruptCharacterVisuals(duration, math.random() < 0.3) end)
		end
		if math.random() < 0.5 then
			task.spawn(function() glitchGameWorld(duration * 0.8) end)
		end

		task.wait(math.random(2, 5))
	end
end)

-- ============================================================
-- СКРИМЕРЫ ПО РАСПИСАНИЮ
-- ============================================================
task.spawn(function()
	while tick() - SESSION_START < FIRST_JUMPSCARE_AT do task.wait(0.3) end

	jumpscareFired = true
	jumpscare()

	task.wait(JUMPSCARE_DURATION + 0.2)
	postJumpscare = true
	-- ⭐ Включаем ПОСТОЯННУЮ порчу всех новых объектов
	worldCorruptionActive = true

	-- Вечная поддержка порчи персонажа
	task.spawn(function()
		while true do
			task.wait(math.random(8, 15))
			if player.Character then
				corruptCharacterVisuals(1.5, math.random() < 0.5)
			end
			-- Постоянно искажаем оверхед всех игроков
			for _, p in ipairs(game.Players:GetPlayers()) do
				if p.Character then
					pcall(function() corruptOverhead(p.Character, 0.9) end)
				end
			end
		end
	end)

	-- 2-й скример через 15 сек после первого
	while tick() - SESSION_START < SECOND_JUMPSCARE_AT do task.wait(0.3) end
	jumpscare()

	-- 3-й и все следующие — каждые 60 сек
	while true do
		local nextAt = tick() + JUMPSCARE_INTERVAL
		while tick() < nextAt do task.wait(0.5) end
		jumpscare()
	end
end)
