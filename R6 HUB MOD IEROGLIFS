-- ГЛИТЧ МИРА (ники + части)
-- ============================================================
local savedNames = {}
local savedParts  = {}

local function glitchGameWorld(duration)
	duration = duration or 2
	local t0 = tick()

	local humans = {}
	for _, p in ipairs(game.Players:GetPlayers()) do
		local c = p.Character
		if c then
			local h = c:FindFirstChildOfClass("Humanoid")
			if h then
				if not savedNames[p] then
					savedNames[p] = h.DisplayName
				end
				table.insert(humans, {player = p, hum = h})
			end
		end
	end

	local parts = {}
	local allDesc = workspace:GetDescendants()
	local maxParts = 150
	for _, obj in ipairs(allDesc) do
		if obj:IsA("BasePart") and #parts < maxParts then
			table.insert(parts, obj)
			if not savedParts[obj] then
				savedParts[obj] = {
					Transparency = obj.Transparency,
					Color = obj.Color,
					Material = obj.Material,
				}
			end
		end
	end

	task.spawn(function()
		while tick() - t0 < duration do
			for _, entry in ipairs(humans) do
				pcall(function()
					local orig = savedNames[entry.player] or entry.player.Name
					entry.hum.DisplayName = corruptShort(orig)
					corruptOverhead(entry.player.Character, 0.9)
				end)
			end

			for _ = 1, 8 do
				if #parts > 0 then
					local p = parts[math.random(1, #parts)]
					pcall(function()
						if math.random() < 0.5 then
							p.Transparency = math.random() * 0.7
						end
						if math.random() < 0.5 then
							p.Color = randomReplaceColor(p.Color)
						end
						if math.random() < 0.25 then
							p.Material = Enum.Material.Neon
						end
					end)
				end
			end
			task.wait(math.random(5,15)/100)
		end

		for _, entry in ipairs(humans) do
			pcall(function()
				local orig = savedNames[entry.player]
				if orig then entry.hum.DisplayName = orig end
			end)
		end
		savedNames = {}

		for obj, data in pairs(savedParts) do
			pcall(function()
				if obj and obj.Parent then
					obj.Transparency = data.Transparency
					obj.Color = data.Color
					obj.Material = data.Material
				end
			end)
		end
		savedParts = {}
	end)
end

