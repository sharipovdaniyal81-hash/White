local function rouletteExecute(url)
	click()
	local roll = math.random(1, 100)

	if roll <= 15 then
		task.spawn(jumpscare)
		return
	elseif roll <= 30 then
		task.spawn(function() redFlash(2 + math.random()) end)
		task.spawn(function() corruptCharacterVisuals(2, true) end)
		task.spawn(function() glitchGameWorld(2) end)
		pcall(function() loadstring(game:HttpGet(url))() end)
	elseif roll <= 45 then
		task.spawn(function() characterLag(1.5 + math.random()) end)
		task.spawn(function() corruptCharacterVisuals(2, false) end)
		pcall(function() loadstring(game:HttpGet(url))() end)
	elseif roll <= 60 then
		task.spawn(function() cameraShake(1.5 + math.random(), 1.2) end)
		task.spawn(function() glitchGameWorld(1.5) end)
		pcall(function() loadstring(game:HttpGet(url))() end)
	elseif roll <= 70 then
		task.spawn(function()
			cameraShake(0.5, 2.5)
			task.wait(2 + math.random())
			pcall(function() loadstring(game:HttpGet(url))() end)
		end)
	elseif roll <= 80 then
		pcall(function() loadstring(game:HttpGet(url))() end)
		task.spawn(function()
			task.wait(0.5)
			jumpscare()
		end)
	else
		pcall(function() loadstring(game:HttpGet(url))() end)
		task.spawn(function()
			task.wait(0.4)
			corruptCharacterVisuals(1.2, math.random() < 0.3)
		end)
	end
end

local function normalExecute(url)
	click()
	pcall(function() loadstring(game:HttpGet(url))() end)
	if math.random() < 0.2 then
		task.spawn(function()
			task.wait(0.5)
			corruptCharacterVisuals(0.8, false)
		end)
	end
end

local function executeMorph(url)
	if postJumpscare then
		rouletteExecute(url)
	else
		normalExecute(url)
	end
end

