-- Пул залго-символов для "наложения" поверх текста
local ZALGO_POOLS = {
	"\204\143\204\190\204\148\204\155\204\156\204\150",
	"\204\140\204\150\204\154\204\153\204\175",
	"\204\139\204\144\204\153\204\146\204\176",
	"\204\148\204\160\204\153\204\186\204\180",
	"\204\143\204\144\204\154\204\160\204\163\204\153\204\175",
}
-- Обёртка залго для любой строки (без генератора, только предзаготовленные пулы)
local function zalgo(text)
	local out = ""
	local idx = 1
	for i = 1, #text do
		local c = text:sub(i,i)
		out = out .. c
		if c ~= " " then
			out = out .. ZALGO_POOLS[((idx-1) % #ZALGO_POOLS) + 1]
			idx = idx + 1
		end
	end
	return out
end

-- Функция: глитч персонажа (анимации ломаются + CFrame дёргается)
local function glitchCharacter(intensity)
	intensity = intensity or 1
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp then return end

	-- Ломаем играющиеся анимации
	if hum then
		local animator = hum:FindFirstChildOfClass("Animator")
		if animator then
			local tracks = animator:GetPlayingAnimationTracks()
			for _, t in ipairs(tracks) do
				pcall(function() t:AdjustSpeed(0) end)
			end
			task.wait(math.random(5,20)/100)
			for _, t in ipairs(tracks) do
				pcall(function()
					t:AdjustSpeed(math.random(0,50)/10 - 2) -- иногда назад, иногда ускоренно
				end)
			end
			task.wait(math.random(10,25)/100)
			for _, t in ipairs(tracks) do
				pcall(function() t:AdjustSpeed(1) end)
			end
		end
	end

	-- Дёргаем CFrame в стороны
	local startCF = hrp.CFrame
	for i = 1, math.random(3,8)*intensity do
		hrp.CFrame = startCF * CFrame.new(
			(math.random()-0.5)*0.8,
			(math.random()-0.5)*0.8,
			(math.random()-0.5)*0.8
		) * CFrame.Angles(
			(math.random()-0.5)*0.3,
			(math.random()-0.5)*0.3,
			(math.random()-0.5)*0.3
		)
		task.wait(0.02 + math.random()*0.03)
	end
	hrp.CFrame = startCF

	-- Рандомная "тряска" гуманоида (платформеры / R6 поддерживают)
	pcall(function()
		hum.PlatformStand = true
		task.wait(math.random(8,20)/100)
		hum.PlatformStand = false
	end)
end

-- Функция: СКРИМЕР — полноэкранный, переливающиеся цвета + пищащий звук
local jumpscareActive = false
local function jumpscare()
	if jumpscareActive then return end
	jumpscareActive = true

	local sg = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
	sg.Name = "JUMPSCARE_"..tick()
	sg.IgnoreGuiInset = true
	sg.DisplayOrder = 2147483647
	sg.ResetOnSpawn = false

	-- Фон с переливающимися цветами
	local frame = Instance.new("Frame", sg)
	frame.Size = UDim2.new(1,0,1,0)
	frame.Position = UDim2.new(0,0,0,0)
	frame.BackgroundColor3 = Color3.fromRGB(255,0,0)
	frame.BorderSizePixel = 0
	frame.ZIndex = 1

	-- Жуткий текст по центру
	local txt = Instance.new("TextLabel", frame)
	txt.Size = UDim2.new(1,0,1,0)
	txt.BackgroundTransparency = 1
	txt.Text = zalgo("YOU ARE HACKED") .. "\n" .. zalgo("WAKE UP") .. "\n" .. zalgo("WAKE UP") .. "\n" .. zalgo("WAKE UP")
	txt.TextColor3 = Color3.fromRGB(255,255,255)
	txt.Font = Enum.Font.GothamBlack
	txt.TextScaled = true
	txt.TextWrapped = true
	txt.ZIndex = 2

	-- Пищащий "взлом" звук (растущий pitch)
	local snd = Instance.new("Sound", sg)
	snd.SoundId = "rbxassetid://9120386436" -- screech
	snd.Volume = 7
	snd.PlaybackSpeed = 1.8
	snd.Looped = true
	snd.PlayOnRemove = true
	snd:Play()

	-- Дополнительный высокочастотный писк
	local snd2 = Instance.new("Sound", sg)
	snd2.SoundId = "rbxassetid://131237241" -- high pitch screech
	snd2.Volume = 5
	snd2.PlaybackSpeed = 2.5
	snd2.Looped = true
	snd2.PlayOnRemove = true
	snd2:Play()

	-- Переливание цветов (быстрое)
	task.spawn(function()
		local t0 = tick()
		while tick() - t0 < 1.8 do
			frame.BackgroundColor3 = Color3.fromRGB(
				math.random(30,255),
				math.random(0,80),
				math.random(100,255)
			)
			frame.BackgroundTransparency = math.random(0,30)/100
			txt.TextColor3 = Color3.fromRGB(
				math.random(180,255),
				math.random(180,255),
				math.random(180,255)
			)
			task.wait(math.random(3,8)/100)
		end
	end)

	-- Тряска гуи
	task.spawn(function()
		local t0 = tick()
		while tick() - t0 < 1.8 do
			frame.Position = UDim2.new(
				(math.random()-0.5)*0.05,
				0,
				(math.random()-0.5)*0.05,
				0
			)
			task.wait(0.03)
		end
		frame.Position = UDim2.new(0,0,0,0)
	end)

	-- Автоудаление
	task.delay(1.8, function()
		pcall(function() snd:Destroy() end)
		pcall(function() snd2:Destroy() end)
		pcall(function() sg:Destroy() end)
		jumpscareActive = false
	end)
end

-- Обёртка над запуском морфа: добавляет жуть
local function executeWithHorror(url)
	click()

	-- Иногда глитч персонажа ДО запуска
	if math.random() < 0.5 then
		task.spawn(function() glitchCharacter(1) end)
	end

	-- Запускаем морф
	local ok, err = pcall(function()
		loadstring(game:HttpGet(url))()
	end)

	-- Иногда глитч ПОСЛЕ запуска (анимации уже новые, ломаем их)
	if math.random() < 0.6 then
		task.spawn(function()
			task.wait(math.random(3,10)/10)
			glitchCharacter(1)
		end)
	end

	-- Скример с шансом ~20%
	if math.random() < 0.2 then
		task.spawn(function()
			task.wait(math.random(5,20)/10)
			jumpscare()
		end)
	end

	-- Постоянная мелкая тряска персонажа после морфа
	task.spawn(function()
		task.wait(math.random(5,15)/10)
		glitchCharacter(0.5)
	end)
end

