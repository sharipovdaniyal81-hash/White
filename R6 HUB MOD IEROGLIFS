-- ПОРЧА ТЕКСТА
-- ============================================================
local corruptionLevel = 0
local HEAVY_TOP = {
	"\204\128","\204\129","\204\130","\204\131","\204\132","\204\133","\204\134","\204\135","\204\136","\204\137",
}
local HEAVY_BOT = {
	"\204\150","\204\151","\204\152","\204\153","\204\154","\204\155","\204\156","\204\157","\204\158","\204\159",
}
local function corruptText(text, level)
	if level <= 0 then return text end
	local marksPerChar = math.floor(level * 30)
	if marksPerChar <= 0 then return text end
	local out = ""
	for i = 1, #text do
		local c = text:sub(i,i)
		out = out .. c
		if c ~= " " and c ~= "\n" then
			for _ = 1, marksPerChar do
				if math.random() < 0.5 then
					out = out .. HEAVY_TOP[math.random(1, #HEAVY_TOP)]
				else
					out = out .. HEAVY_BOT[math.random(1, #HEAVY_BOT)]
				end
			end
		end
	end
	return out
end

local trackedTexts = {}
local function registerText(label)
	table.insert(trackedTexts, {label = label, orig = label.Text})
end
local function refreshAllText()
	for _, item in ipairs(trackedTexts) do
		pcall(function() item.label.Text = corruptText(item.orig, corruptionLevel) end)
	end
end

task.spawn(function()
	while true do
		task.wait(0.5)
		local elapsed = tick() - SESSION_START
		if elapsed < GLITCH_START_AT then
			corruptionLevel = 0
		elseif elapsed < JUMPSCARE_AT then
			local t = (elapsed - GLITCH_START_AT) / (JUMPSCARE_AT - GLITCH_START_AT)
			corruptionLevel = math.clamp(0.1 + t * 0.4, 0, 0.5)
		else
			corruptionLevel = 1.0
		end
		refreshAllText()
	end
end)

