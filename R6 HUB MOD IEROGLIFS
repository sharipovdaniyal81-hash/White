-- ============================================================
-- ГЛИТЧИ ДО СКРИМЕРА (15–60 сек)
-- ============================================================
task.spawn(function()
	task.wait(GLITCH_START_AT)
	while not jumpscareFired do
		local elapsed = tick() - SESSION_START
		local progress = math.clamp(elapsed / JUMPSCARE_AT, 0, 1)

		local intensity = 0.6 + progress * 1.5
		local duration  = 0.4 + progress * 1.2

		cameraShake(intensity, duration)

		if math.random() < 0.7 then
			characterLag(duration * 0.6)
		end

		local waitTime = math.random(6, 14) * (1 - progress * 0.7)
		task.wait(waitTime)
	end
end)

-- ============================================================
-- СКРИМЕР НА 60 СЕК + АКТИВАЦИЯ РУЛЕТКИ
-- ============================================================
task.spawn(function()
	while tick() - SESSION_START < JUMPSCARE_AT do
		task.wait(0.5)
	end
	jumpscareFired = true
	jumpscare()

	-- Через 3 сек после начала скримера (когда он закончится) — врубаем рулетку
	task.wait(3)
	postJumpscare = true
end)
