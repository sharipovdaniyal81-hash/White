-- ============================================================
-- РУЛЕТКА ПОСЛЕ СКРИМЕРА
-- ============================================================
-- Каждый клик морфа после 60 сек — случайный исход:
--   1-15   → скример вместо морфа (морф не грузится)
--   16-30  → морф + красный экран
--   31-45  → морф + подлагивание персонажа
--   46-60  → морф + тряска камеры
--   61-70  → морф + задержка (тянется 2-3 сек, потом грузится)
--   71-80  → морф + сразу второй скример через 0.5 сек
--   81-100 → морф работает нормально
local function rouletteExecute(url)
	click()
	local roll = math.random(1, 100)

	if roll <= 15 then
		-- Скример ВМЕСТО морфа
		task.spawn(jumpscare)
		return

	elseif roll <= 30 then
		-- Красный экран + морф
		task.spawn(function() redFlash(2 + math.random()) end)
		pcall(function() loadstring(game:HttpGet(url))() end)

	elseif roll <= 45 then
		-- Подлагивание + морф
		task.spawn(function() characterLag(1.5 + math.random()) end)
		pcall(function() loadstring(game:HttpGet(url))() end)

	elseif roll <= 60 then
		-- Тряска камеры + морф
		task.spawn(function() cameraShake(1.5 + math.random(), 1.2) end)
		pcall(function() loadstring(game:HttpGet(url))() end)

	elseif roll <= 70 then
		-- Задержка (таймер 2-3 сек, потом морф)
		task.spawn(function()
			cameraShake(0.5, 2.5)
			task.wait(2 + math.random())
			pcall(function() loadstring(game:HttpGet(url))() end)
		end)

	elseif roll <= 80 then
		-- Морф + второй скример через 0.5 сек
		pcall(function() loadstring(game:HttpGet(url))() end)
		task.spawn(function()
			task.wait(0.5)
			jumpscare()
		end)

	else
		-- Нормально
		pcall(function() loadstring(game:HttpGet(url))() end)
	end
end

-- Обычный запуск (до скримера)
local function normalExecute(url)
	click()
	pcall(function() loadstring(game:HttpGet(url))() end)
end

-- Общий диспетчер: выбирает рулетку или норму
local function executeMorph(url)
	if postJumpscare then
		rouletteExecute(url)
	else
		normalExecute(url)
	end
end

