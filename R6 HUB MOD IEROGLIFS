local ZALGO_SHORT = { "̸̷̶̵̴", "̶̸̷̵̳", "̴̸̷̵̶", "̵̶̷̸̳", "̸̿̋̚", "̶̷̸̵̳" }
local function corruptShort(text)
	local out = ""
	for i = 1, #text do
		local c = text:sub(i, i)
		out = out .. c
		if c ~= " " then
			out = out .. ZALGO_SHORT[math.random(1, #ZALGO_SHORT)]
			if math.random() < 0.5 then
				out = out .. ZALGO_SHORT[math.random(1, #ZALGO_SHORT)]
			end
		end
	end
