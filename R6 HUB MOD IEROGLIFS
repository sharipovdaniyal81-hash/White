-- ПОДЛАГИВАНИЕ ПЕРСОНАЖА
-- ============================================================
local function characterLag(duration)
	local char = player.Character
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return end

	local oldSpeed = hum.WalkSpeed
	local oldJump = hum.JumpPower
	hum.WalkSpeed = 0
	hum.JumpPower = 0

	local animator = hum:FindFirstChildOfClass("Animator")
	local broken = {}
	if animator then
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
			pcall(function()
				t:AdjustSpeed(0)
				table.insert(broken, t)
			end)
		end
	end

	task.spawn(function()
		local t0 = tick()
		while tick() - t0 < duration do
			local cf = hrp.CFrame
			hrp.CFrame = cf * CFrame.new(
				(math.random()-0.5) * 0.3,
				(math.random()-0.5) * 0.3,
				(math.random()-0.5) * 0.3
			)
			task.wait(math.random(3,8)/100)
		end
		hum.WalkSpeed = oldSpeed
		hum.JumpPower = oldJump
		for _, t in ipairs(broken) do
			pcall(function() t:AdjustSpeed(math.random(1,30)/10) end)
		end
		task.wait(0.15)
		for _, t in ipairs(broken) do
			pcall(function() t:AdjustSpeed(1) end)
		end
	end)
end

