-- ⭐ Рандомная "замена цвета" — зелёный на красный, любой на чёрный и т.д.
local function randomReplaceColor(origColor)
	-- 30% — чёрный (обесцвечивание)
	if math.random() < 0.3 then return Color3.fromRGB(0,0,0) end
	-- 20% — красный
	if math.random() < 0.5 then return Color3.fromRGB(200,0,0) end
	-- 15% — тёмно-фиолетовый
	if math.random() < 0.65 then return Color3.fromRGB(30,0,50) end
	-- остальное — любой жуткий
	return CREEPY_COLORS[math.random(1, #CREEPY_COLORS)]
end

local function corruptCharacterVisuals(duration, meshReplace)
	duration = duration or 2
	local char = player.Character
	if not char then return end
	local t0 = tick()

	local saved = {}
	for _, obj in ipairs(char:GetDescendants()) do
		if obj:IsA("BasePart") then
			saved[obj] = {
				Color = obj.Color,
				Material = obj.Material,
				Transparency = obj.Transparency,
				Size = obj.Size,
			}
		elseif obj:IsA("SpecialMesh") or obj:IsA("BlockMesh") or obj:IsA("CylinderMesh") or obj:IsA("FileMesh") then
			saved[obj] = {
				Scale = obj.Scale,
				Offset = obj.Offset,
				MeshId = obj.MeshId,
			}
		end
	end

	task.spawn(function()
		while tick() - t0 < duration do
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BasePart") then
					pcall(function()
						-- ⭐ чаще меняем цвета (было 0.35)
						if math.random() < 0.5 then
							obj.Color = randomReplaceColor(obj.Color)
						end
						if math.random() < 0.35 then
							obj.Material = CREEPY_MATERIALS[math.random(1, #CREEPY_MATERIALS)]
						end
						if math.random() < 0.3 then
							obj.Transparency = math.random() * 0.5
						end
						if math.random() < 0.2 then
							obj.Size = obj.Size * (0.8 + math.random() * 0.4)
						end
					end)
				elseif obj:IsA("SpecialMesh") then
					pcall(function()
						if math.random() < 0.4 then
							obj.Scale = obj.Scale * Vector3.new(
								0.5 + math.random() * 1.0,
								0.5 + math.random() * 1.5,
								0.5 + math.random() * 1.0
							)
						end
						if math.random() < 0.3 then
							obj.Offset = Vector3.new(
								(math.random()-0.5)*0.8,
								(math.random()-0.5)*0.8,
								(math.random()-0.5)*0.8
							)
						end
						if meshReplace and math.random() < 0.2 then
							obj.MeshId = CREEPY_MESH_IDS[math.random(1, #CREEPY_MESH_IDS)]
						end
					end)
				end
			end
			task.wait(0.07)
		end

		for obj, data in pairs(saved) do
			pcall(function()
				if obj and obj.Parent then
					for k, v in pairs(data) do obj[k] = v end
				end
			end)
		end
	end)
end

