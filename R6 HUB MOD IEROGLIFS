-- Переливание фона хаба (как раньше)
local function tweenColor(object, color1, color2, duration)
	while true do
		TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Linear), {BackgroundColor3 = color2}):Play()
		task.wait(duration)
		TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Linear), {BackgroundColor3 = color1}):Play()
		task.wait(duration)
	end
end

